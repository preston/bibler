# Host-run development configuration. Startup migrates, but never seeds or imports.
BIBLER_SERVER_DATABASE_URL=postgresql://bibler:password@127.0.0.1:5433/bibler_development
BIBLER_SERVER_PORT=3000
BIBLER_SERVER_BIBLE_DATABASES_PATH=../../bible_databases
# Ollama is external to the application stack.
BIBLER_SERVER_OLLAMA_URL=http://localhost:11434
# Optional default model; request-specific model selections take precedence.
BIBLER_SERVER_OLLAMA_MODEL=bigwest60/bible-scholar:latest
# Optional smaller/different model for the explicit live smoke check only.
# BIBLER_SERVER_OLLAMA_TEST_MODEL=
BIBLER_SERVER_OLLAMA_OPEN_TIMEOUT=2
BIBLER_SERVER_OLLAMA_WRITE_TIMEOUT=30
BIBLER_SERVER_OLLAMA_READ_TIMEOUT=180
BIBLER_SERVER_OLLAMA_STREAM_READ_TIMEOUT=600
BIBLER_SERVER_OLLAMA_RETRIES=1
BIBLER_SERVER_OLLAMA_NUM_CTX=131072
# Optional comma-separated upstream translation abbreviations; unset imports all.
# BIBLER_SERVER_IMPORT_TRANSLATIONS=KJV,ASV
# Explicit fresh-install administrator setup. Supply your own password before db:seed.
BIBLER_SERVER_BOOTSTRAP_ADMIN_USERNAME=administrator
BIBLER_SERVER_BOOTSTRAP_ADMIN_EMAIL=administrator@localhost
# BIBLER_SERVER_BOOTSTRAP_ADMIN_PASSWORD=
