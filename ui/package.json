{
  "name": "bibler-ui",
  "version": "4.0.0",
  "description": "Web-based user interface for Bibler.",
  "license": "ISC",
  "repository": "git@github.com:preston/bibler.git",
  "author": "Preston Lee",
  "scripts": {
    "ng": "ng",
    "configure": "node scripts/configure.mjs",
    "start": "npm run configure && ng serve --host 0.0.0.0",
    "build": "npm run configure && ng build",
    "watch": "npm run configure && ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.2",
    "@angular/cdk": "~22.2.2",
    "@angular/common": "~22.2.2",
    "@angular/compiler": "~22.2.2",
    "@angular/core": "~22.2.2",
    "@angular/forms": "~22.2.2",
    "@angular/platform-browser": "~22.2.2",
    "@angular/platform-browser-dynamic": "~22.2.2",
    "@angular/router": "~22.2.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "bibler-core": "file:../core"
  },
  "devDependencies": {
    "@angular/cli": "~22.2.2",
    "@angular/compiler-cli": "~22.2.2",
    "@types/node": "^26.0.0",
    "typescript": "~6.0.0",
    "@angular/build": "~22.2.2"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "type": "module"
}
