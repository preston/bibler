# Compose local defaults. Use separate credentials and pinned image tags for deployment.
BIBLER_DATABASE_HOST_PORT=5433
BIBLER_POSTGRES_DB=bibler_development
BIBLER_POSTGRES_USER=bibler
BIBLER_POSTGRES_PASSWORD=password
BIBLER_API_HOST_PORT=3000
BIBLER_UI_HOST_PORT=4200
BIBLER_IMAGE_TAG=latest
# Browser-visible API origin, without /api.
BIBLER_SERVER_URL=http://localhost:3000
# Compose server reaches Ollama on the host; no Ollama container is started.
BIBLER_SERVER_OLLAMA_URL=http://host.docker.internal:11434
# Set BIBLER_SERVER_OLLAMA_MODEL in server/.env to override the API default model.
# BIBLER_SERVER_OLLAMA_TEST_MODEL in server/.env overrides only the live smoke check.
# Optional import source checkout; always mounted read-only in the server container.
BIBLER_SERVER_BIBLE_DATABASES_PATH=../bible_databases
